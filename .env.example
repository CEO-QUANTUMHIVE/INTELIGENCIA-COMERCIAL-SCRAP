# ─── IA ──────────────────────────────────────────────────────────────
# claude | openai
PROVEEDOR_IA=claude

ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-opus-5
# Para analizar cientos de negocios barato: claude-sonnet-5

OPENAI_API_KEY=
MODELO_OPENAI=gpt-5

# ─── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=
# Usar la service_role key (el backend escribe, no es un cliente público)
SUPABASE_KEY=

# ─── Scraping ────────────────────────────────────────────────────────
# Poner en false para ver el navegador mientras scrapea (útil para depurar)
NAVEGADOR_OCULTO=true
# Segundos de espera entre negocios (para no golpear a Google)
PAUSA_ENTRE_NEGOCIOS=1.5

# ─── API ─────────────────────────────────────────────────────────────
PUERTO=8000
