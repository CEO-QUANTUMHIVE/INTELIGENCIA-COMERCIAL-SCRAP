# ─── IA ──────────────────────────────────────────────────────────────
# claude | openai
PROVEEDOR_IA=claude

ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-opus-5
# Para analizar cientos de negocios barato: claude-sonnet-5

OPENAI_API_KEY=
MODELO_OPENAI=gpt-5

# ─── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=
# Usar la service_role key (el backend escribe, no es un cliente público)
SUPABASE_KEY=

# ─── Scraping ────────────────────────────────────────────────────────
# Poner en false para ver el navegador mientras scrapea (útil para depurar)
NAVEGADOR_OCULTO=true
# Segundos de espera entre negocios (para no golpear a Google)
PAUSA_ENTRE_NEGOCIOS=1.5

# Proveedor de perfiles públicos de Instagram. El token queda solo en backend.
# Actor estable mantenido por Apify; se puede reemplazar sin cambiar código.
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_INSTAGRAM_TIMEOUT=120

# Búsqueda web del Cazador de Recursos. Ejecuta una sola página por consulta
# con el Actor oficial de Google Search mantenido por Apify.
APIFY_BUSQUEDA_ACTOR=apify~google-search-scraper
APIFY_BUSQUEDA_TIMEOUT=120
APIFY_BUSQUEDA_MAX_COSTO_USD=0.50

# ─── Outreach / Chatwoot ─────────────────────────────────────────────
# El inbox email puede enviar; el inbox manual solo guarda notas y links para
# WhatsApp, Instagram y Facebook, sin simular DMs fríos no admitidos por Meta.
CHATWOOT_URL=
CHATWOOT_API_KEY=
CHATWOOT_ACCOUNT_ID=0
CHATWOOT_INBOX_EMAIL_ID=0
CHATWOOT_INBOX_MANUAL_ID=0
CHATWOOT_TIMEOUT=20

# ─── API ─────────────────────────────────────────────────────────────
PUERTO=8000
# Token que tienen que mandar los consumidores externos (Fábrica de Webs,
# Fábrica de Agentes) como "Authorization: Bearer <token>". Vacío en local
# = sin auth. Setealo antes de exponer la API afuera de tu red.
TOKEN_INTERNO=
